<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Trading Report</title>
    <!-- Menggunakan Tailwind CSS via CDN untuk kemudahan styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a; /* slate-900 */
            color: #f8fafc; /* slate-50 */
            -webkit-print-color-adjust: exact;
        }
        .page-break {
            page-break-before: always;
        }
        table {
            page-break-inside: auto;
        }
        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }
        thead {
            display: table-header-group;
        }
        tfoot {
            display: table-footer-group;
        }
    </style>
</head>
<body class="p-8 antialiased">
    
    <!-- Header Laporan -->
    <div class="border-b border-slate-700 pb-6 mb-8 flex justify-between items-end">
        <div>
            <h1 class="text-4xl font-bold text-sky-400 mb-2">ENGULFING ANALYTICS</h1>
            <h2 class="text-2xl text-slate-300"><%= reportTitle %></h2>
        </div>
        <div class="text-right">
            <p class="text-slate-400">Tanggal Cetak:</p>
            <p class="text-lg font-semibold"><%= currentDate %></p>
        </div>
    </div>

    <!-- Ringkasan Eksekutif -->
    <div class="grid grid-cols-4 gap-4 mb-8">
        <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-lg text-center">
            <p class="text-slate-400 text-sm mb-1">Total Trading</p>
            <p class="text-3xl font-bold text-white"><%= stats.totalTrades %></p>
        </div>
        <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-lg text-center">
            <p class="text-slate-400 text-sm mb-1">Akurasi (Win Rate)</p>
            <p class="text-3xl font-bold <%= stats.winRate >= 50 ? 'text-emerald-400' : 'text-rose-400' %>">
                <%= stats.winRate.toFixed(1) %>%
            </p>
        </div>
        <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-lg text-center">
            <p class="text-slate-400 text-sm mb-1">Total Profit</p>
            <p class="text-3xl font-bold text-emerald-400">
                $<%= stats.totalProfit.toFixed(2) %>
            </p>
        </div>
        <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-lg text-center">
            <p class="text-slate-400 text-sm mb-1">Keuntungan Bersih</p>
            <p class="text-3xl font-bold <%= stats.netProfit >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                $<%= stats.netProfit.toFixed(2) %>
            </p>
        </div>
    </div>

    <!-- Tabel Rincian Transaksi -->
    <h3 class="text-xl font-semibold mb-4 text-slate-200">Rincian Transaksi</h3>
    
    <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden shadow-lg mb-8">
        <table class="w-full text-left text-sm text-slate-300">
            <thead class="bg-slate-900 text-slate-400 font-semibold uppercase text-xs">
                <tr>
                    <th class="px-6 py-4 border-b border-slate-700">Waktu (WIB)</th>
                    <th class="px-6 py-4 border-b border-slate-700">Simbol / TF</th>
                    <th class="px-6 py-4 border-b border-slate-700">Mode</th>
                    <th class="px-6 py-4 border-b border-slate-700">Rasio Engulf</th>
                    <th class="px-6 py-4 border-b border-slate-700 text-right">Profit / Loss</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-700">
                <% if (trades.length === 0) { %>
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                            Tidak ada sinyal trading pada periode ini.
                        </td>
                    </tr>
                <% } else { %>
                    <% trades.forEach(function(trade) { %>
                        <tr class="hover:bg-slate-750">
                            <td class="px-6 py-4"><%= trade.formattedTime %></td>
                            <td class="px-6 py-4 font-semibold text-white">
                                <%= trade.symbol %> <span class="text-xs text-slate-400 font-normal ml-1"><%= trade.timeframe %></span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 text-xs font-bold rounded bg-slate-900 border <%= trade.mode === 'BUY' ? 'text-emerald-400 border-emerald-900/50' : 'text-rose-400 border-rose-900/50' %>">
                                    <%= trade.mode %>
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <%= trade.engulf_ratio ? trade.engulf_ratio.toFixed(2) + 'x' : '-' %>
                            </td>
                            <td class="px-6 py-4 text-right font-mono font-bold <%= trade.profit >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                                <%= trade.profit >= 0 ? '+' : '' %>$<%= trade.profit.toFixed(2) %>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Halaman Screenshot Lampiran (Opsional, jika ada gambar) -->
    <% if (trades.length > 0) { %>
        <div class="page-break"></div>
        <h3 class="text-xl font-semibold mb-6 text-slate-200">Lampiran Bukti Transaksi</h3>
        <div class="grid grid-cols-2 gap-6">
            <% trades.forEach(function(trade, index) { %>
                <% if (trade.image_url) { %>
                    <div class="bg-slate-800 p-3 rounded-xl border border-slate-700 shadow-md">
                        <div class="flex justify-between items-center mb-2 text-xs text-slate-400">
                            <span>#<%= index + 1 %> - <%= trade.symbol %> (<%= trade.mode %>)</span>
                            <span class="<%= trade.profit >= 0 ? 'text-emerald-400' : 'text-rose-400' %> font-bold">
                                $<%= trade.profit.toFixed(2) %>
                            </span>
                        </div>
                        <img src="<%= trade.image_url %>" class="w-full h-auto rounded border border-slate-700" alt="Trade Screenshot">
                    </div>
                <% } %>
            <% }); %>
        </div>
    <% } %>

</body>
</html>
