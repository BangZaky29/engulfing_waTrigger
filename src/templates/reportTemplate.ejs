<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Trading Report</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
            color: #1f2937; /* gray-800 */
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        .page-break {
            page-break-before: always;
        }
        table {
            page-break-inside: auto;
        }
        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }
        thead {
            display: table-header-group;
        }
    </style>
</head>
<body class="p-10 antialiased max-w-4xl mx-auto">
    
    <!-- Header Minimalis -->
    <div class="flex justify-between items-end border-b-2 border-gray-200 pb-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight">ENGULFING STRATEGY</h1>
            <h2 class="text-xl font-medium text-gray-500 mt-1"><%= reportTitle %></h2>
        </div>
        <div class="text-right text-sm">
            <p class="text-gray-500 font-medium uppercase tracking-wider text-xs">Tanggal Cetak</p>
            <p class="font-semibold text-gray-800"><%= currentDate %></p>
        </div>
    </div>

    <!-- Ringkasan Eksekutif Minimalis -->
    <div class="grid grid-cols-4 gap-6 mb-10">
        <div class="bg-gray-50 rounded-lg p-5 border border-gray-200">
            <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider mb-2">Total Sinyal</p>
            <p class="text-3xl font-bold text-gray-900"><%= stats.totalTrades %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-5 border border-gray-200">
            <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider mb-2">Win Rate</p>
            <p class="text-3xl font-bold <%= stats.winRate >= 50 ? 'text-green-600' : 'text-red-600' %>">
                <%= stats.winRate.toFixed(1) %>%
            </p>
        </div>
        <div class="bg-gray-50 rounded-lg p-5 border border-gray-200">
            <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider mb-2">Profit Kotor</p>
            <p class="text-3xl font-bold text-gray-900">
                $<%= stats.totalProfit.toFixed(2) %>
            </p>
        </div>
        <div class="bg-gray-50 rounded-lg p-5 border border-gray-200">
            <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider mb-2">Profit Bersih</p>
            <p class="text-3xl font-bold <%= stats.netProfit >= 0 ? 'text-green-600' : 'text-red-600' %>">
                $<%= stats.netProfit.toFixed(2) %>
            </p>
        </div>
    </div>

    <!-- Tabel Rincian -->
    <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-bold text-gray-800">Catatan Transaksi</h3>
        <span class="text-xs text-gray-500 font-medium bg-gray-100 px-3 py-1 rounded-full"><%= periodRange %></span>
    </div>
    
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-10">
        <table class="w-full text-left text-sm">
            <thead class="bg-gray-100 text-gray-600 font-semibold text-xs uppercase tracking-wider">
                <tr>
                    <th class="px-5 py-3 border-b border-gray-200">Waktu (WIB)</th>
                    <th class="px-5 py-3 border-b border-gray-200">Simbol</th>
                    <th class="px-5 py-3 border-b border-gray-200">TF</th>
                    <th class="px-5 py-3 border-b border-gray-200">Mode</th>
                    <th class="px-5 py-3 border-b border-gray-200">Rasio</th>
                    <th class="px-5 py-3 border-b border-gray-200 text-right">Hasil ($)</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
                <% if (trades.length === 0) { %>
                    <tr>
                        <td colspan="6" class="px-5 py-8 text-center text-gray-500 font-medium">
                            Tidak ada transaksi pada periode ini.
                        </td>
                    </tr>
                <% } else { %>
                    <% trades.forEach(function(trade) { %>
                        <tr class="hover:bg-gray-50">
                            <td class="px-5 py-3 text-gray-600"><%= trade.formattedTime %></td>
                            <td class="px-5 py-3 font-semibold text-gray-800"><%= trade.symbol %></td>
                            <td class="px-5 py-3 text-gray-500"><%= trade.timeframe %></td>
                            <td class="px-5 py-3">
                                <span class="px-2 py-0.5 text-xs font-bold rounded-md <%= trade.mode === 'BUY' ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-red-50 text-red-700 border border-red-200' %>">
                                    <%= trade.mode %>
                                </span>
                            </td>
                            <td class="px-5 py-3 text-gray-600 font-medium">
                                <%= trade.engulf_ratio ? trade.engulf_ratio.toFixed(2) + 'x' : '-' %>
                            </td>
                            <td class="px-5 py-3 text-right font-mono font-bold <%= trade.profit >= 0 ? 'text-green-600' : 'text-red-600' %>">
                                <%= trade.profit >= 0 ? '+' : '' %><%= trade.profit.toFixed(2) %>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Footer minimalis -->
    <div class="mt-12 pt-4 border-t border-gray-200 text-center text-xs text-gray-400 font-medium">
        Laporan ini digenerate secara otomatis oleh sistem Engulfing Analytics.
    </div>

</body>
</html>
