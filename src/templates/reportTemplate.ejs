<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <title>Trading Portfolio Report — Dual Strategy</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        table {
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        thead {
            display: table-header-group;
        }

        .no-break {
            page-break-inside: avoid;
        }

        .badge-green { background: #14532d; color: #4ade80; border: 1px solid #16a34a; }
        .badge-yellow { background: #713f12; color: #fde047; border: 1px solid #ca8a04; }
        .badge-red { background: #7f1d1d; color: #fca5a5; border: 1px solid #dc2626; }
        .badge-gray { background: #334155; color: #cbd5e1; border: 1px solid #475569; }

        .card-dark {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 16px;
        }

        .card-accent {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
            border: 1px solid #4338ca;
            border-radius: 12px;
            padding: 18px;
        }
    </style>
</head>

<body class="p-6">

    <!-- ── HEADER ── -->
    <div class="flex justify-between items-center pb-6 border-b border-slate-700 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full badge-<%= stats.performanceColor %>">
                    <%= stats.performanceLevel %>
                </span>
                <span class="text-xs text-slate-400 font-medium"><%= periodRange %></span>
            </div>
            <h1 class="text-2xl font-extrabold tracking-tight text-white"><%= reportTitle %></h1>
            <p class="text-xs text-slate-400 mt-0.5">Laporan Dual-Strategi Algoritma Trading MT5 (Tuyul Maling & Tuyul Copet)</p>
        </div>
        <div class="text-right">
            <span class="text-xs text-slate-400 block">Dicetak pada:</span>
            <span class="text-xs font-semibold text-slate-200"><%= currentDate %></span>
        </div>
    </div>

    <!-- ── COMBINED EXECUTIVE KPI METRICS ── -->
    <div class="grid grid-cols-4 gap-4 mb-6">
        <div class="card-dark">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Net PnL</span>
            <div class="text-2xl font-extrabold mt-1 <%= stats.combined.totalNetProfit >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                <%= stats.combined.totalNetProfit >= 0 ? '+' : '' %>$<%= stats.combined.totalNetProfit.toFixed(2) %>
            </div>
            <span class="text-xs text-slate-400 mt-1 block">Hasil Portofolio Akumulasi</span>
        </div>
        <div class="card-dark">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Win Rate Combined</span>
            <div class="text-2xl font-extrabold mt-1 text-indigo-400">
                <%= stats.combined.combinedWinRate.toFixed(1) %>%
            </div>
            <span class="text-xs text-slate-400 mt-1 block">Akurasi Eksekusi Portofolio</span>
        </div>
        <div class="card-dark">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Profit Factor</span>
            <div class="text-2xl font-extrabold mt-1 text-cyan-400">
                <%= stats.combined.combinedProfitFactor === 999 ? '∞' : stats.combined.combinedProfitFactor.toFixed(2) %>x
            </div>
            <span class="text-xs text-slate-400 mt-1 block">Rasio Reward / Risk</span>
        </div>
        <div class="card-dark">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Eksekusi</span>
            <div class="text-2xl font-extrabold mt-1 text-amber-400">
                <%= stats.combined.totalExecutions %>
            </div>
            <span class="text-xs text-slate-400 mt-1 block">Siklus / Transaksi Ditutup</span>
        </div>
    </div>

    <!-- ── DUAL STRATEGY BREAKDOWN ── -->
    <div class="grid grid-cols-2 gap-6 mb-6">
        
        <!-- STRATEGI 1: TUYUL MALING (ENGULFING) -->
        <div class="card-dark border-emerald-500/30">
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-700">
                <div class="flex items-center gap-2">
                    <span class="text-lg">🥷</span>
                    <h2 class="text-base font-bold text-emerald-400">TUYUL MALING (Engulfing)</h2>
                </div>
                <span class="text-xs bg-emerald-950 text-emerald-300 font-semibold px-2 py-0.5 rounded border border-emerald-800">
                    Net PnL: <%= stats.engulfing.netProfit >= 0 ? '+' : '' %>$<%= stats.engulfing.netProfit.toFixed(2) %>
                </span>
            </div>
            <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="bg-slate-900/60 p-2.5 rounded">
                    <span class="text-slate-400 block">Total Trade:</span>
                    <span class="font-bold text-white text-sm"><%= stats.engulfing.totalTrades %> (<%= stats.engulfing.wins %>W / <%= stats.engulfing.losses %>L)</span>
                </div>
                <div class="bg-slate-900/60 p-2.5 rounded">
                    <span class="text-slate-400 block">Win Rate:</span>
                    <span class="font-bold text-emerald-400 text-sm"><%= stats.engulfing.winRate.toFixed(1) %>%</span>
                </div>
                <div class="bg-slate-900/60 p-2.5 rounded">
                    <span class="text-slate-400 block">Gross Profit / Loss:</span>
                    <span class="font-bold text-slate-200">+$$<%= stats.engulfing.grossProfit.toFixed(2) %> / -$$<%= stats.engulfing.grossLoss.toFixed(2) %></span>
                </div>
                <div class="bg-slate-900/60 p-2.5 rounded">
                    <span class="text-slate-400 block">Profit Factor:</span>
                    <span class="font-bold text-cyan-400"><%= stats.engulfing.profitFactor === 999 ? '∞' : stats.engulfing.profitFactor.toFixed(2) %>x</span>
                </div>
            </div>
        </div>

        <!-- STRATEGI 2: TUYUL COPET (RCS) -->
        <div class="card-dark border-cyan-500/30">
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-700">
                <div class="flex items-center gap-2">
                    <span class="text-lg">🏎️</span>
                    <h2 class="text-base font-bold text-cyan-400">TUYUL COPET (RCS System)</h2>
                </div>
                <span class="text-xs bg-cyan-950 text-cyan-300 font-semibold px-2 py-0.5 rounded border border-cyan-800">
                    Net PnL: <%= stats.rcs.netProfit >= 0 ? '+' : '' %>$<%= stats.rcs.netProfit.toFixed(2) %>
                </span>
            </div>
            <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="bg-slate-900/60 p-2.5 rounded">
                    <span class="text-slate-400 block">Total Siklus Selesai:</span>
                    <span class="font-bold text-white text-sm"><%= stats.rcs.totalCycles %> Siklus</span>
                </div>
                <div class="bg-slate-900/60 p-2.5 rounded">
                    <span class="text-slate-400 block">OP1 Hits vs OP2 Limit:</span>
                    <span class="font-bold text-cyan-400 text-sm"><%= stats.rcs.op1Hits %> OP1 / <%= stats.rcs.op2ReentryHits %> OP2</span>
                </div>
                <div class="bg-slate-900/60 p-2.5 rounded">
                    <span class="text-slate-400 block">SL / OP3 Hedge Hits:</span>
                    <span class="font-bold text-rose-400"><%= stats.rcs.op3SlHits %> Kena SL</span>
                </div>
                <div class="bg-slate-900/60 p-2.5 rounded">
                    <span class="text-slate-400 block">Freeze & Recovery Rate:</span>
                    <span class="font-bold text-amber-400"><%= stats.rcs.freezeCount %> Freeze (<%= stats.rcs.recoveryRate.toFixed(1) %>%)</span>
                </div>
            </div>
        </div>

    </div>

    <!-- ── GEMINI AI ANALYTICS & INSIGHT SECTION ── -->
    <div class="card-accent mb-6 no-break">
        <div class="flex justify-between items-center mb-3">
            <div class="flex items-center gap-2">
                <span class="text-xl">🤖</span>
                <h3 class="text-lg font-bold text-white">GEMINI AI QUANT ANALYTICS</h3>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full text-white" style="background: <%= stats.gradient %>;">
                <%= stats.label %>
            </span>
        </div>

        <!-- Portofolio Summary -->
        <p class="text-sm text-indigo-100 leading-relaxed mb-4">
            <%= stats.aiInsight.summary %>
        </p>

        <!-- Sub-Analysis Dual Strategy -->
        <div class="grid grid-cols-2 gap-4 mb-4">
            <% if (stats.aiInsight.engulfingAnalysis) { %>
            <div class="bg-indigo-950/70 border border-indigo-700/40 p-3 rounded-lg text-xs">
                <span class="font-bold text-emerald-400 block mb-1">🥷 Tuyul Maling Insight:</span>
                <p class="text-slate-300 mb-2"><%= stats.aiInsight.engulfingAnalysis.summary %></p>
                <span class="font-semibold text-emerald-300 block">Saran Optimasi:</span>
                <p class="text-slate-300"><%= stats.aiInsight.engulfingAnalysis.recommendation %></p>
            </div>
            <% } %>

            <% if (stats.aiInsight.rcsAnalysis) { %>
            <div class="bg-indigo-950/70 border border-indigo-700/40 p-3 rounded-lg text-xs">
                <span class="font-bold text-cyan-400 block mb-1">🏎️ Tuyul Copet Insight:</span>
                <p class="text-slate-300 mb-2"><%= stats.aiInsight.rcsAnalysis.summary %></p>
                <span class="font-semibold text-cyan-300 block">Saran Optimasi:</span>
                <p class="text-slate-300"><%= stats.aiInsight.rcsAnalysis.recommendation %></p>
            </div>
            <% } %>
        </div>

        <!-- Rekomendasi Utama -->
        <div class="bg-slate-900/80 border border-indigo-500/30 p-3 rounded-lg text-xs">
            <span class="font-bold text-amber-400 block mb-1">🎯 Rekomendasi Eksekutif AI:</span>
            <p class="text-slate-200 font-medium"><%= stats.aiInsight.recommendation %></p>
        </div>
    </div>

    <!-- ── TRANSACTION HISTORY TABLE ── -->
    <div class="card-dark">
        <h3 class="text-sm font-bold text-slate-200 mb-3 uppercase tracking-wider">Log Riwayat Transaksi Portofolio</h3>
        
        <table class="w-full text-left text-xs border-collapse">
            <thead>
                <tr class="bg-slate-900 text-slate-400 border-b border-slate-700">
                    <th class="py-2.5 px-3">Strategi</th>
                    <th class="py-2.5 px-3">Waktu</th>
                    <th class="py-2.5 px-3">Symbol</th>
                    <th class="py-2.5 px-3">Mode / Info</th>
                    <th class="py-2.5 px-3">Hasil</th>
                    <th class="py-2.5 px-3 text-right">Net PnL ($)</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
                <% if (trades && trades.length > 0) { %>
                    <% trades.forEach(function(t) { %>
                        <tr class="hover:bg-slate-800/50">
                            <td class="py-2 px-3">
                                <% if (t.strategy === 'ENGULFING') { %>
                                    <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-emerald-950 text-emerald-400 border border-emerald-800">MALING</span>
                                <% } else { %>
                                    <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-cyan-950 text-cyan-400 border border-cyan-800">COPET</span>
                                <% } %>
                            </td>
                            <td class="py-2 px-3 text-slate-300 font-mono text-[11px]"><%= t.formattedTime || '-' %></td>
                            <td class="py-2 px-3 font-semibold text-white"><%= t.symbol %></td>
                            <td class="py-2 px-3 text-slate-300"><%= t.mode %></td>
                            <td class="py-2 px-3 font-bold <%= t.profit >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                                <%= t.result %>
                            </td>
                            <td class="py-2 px-3 text-right font-mono font-bold <%= t.profit >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                                <%= t.profit >= 0 ? '+' : '' %>$<%= (t.profit || 0).toFixed(2) %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="py-4 text-center text-slate-500">Tidak ada riwayat transaksi pada periode ini.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

</body>
</html>